{
  "stage": 2,
  "seed": 20261121,
  "seq_len": 128,
  "vocab_target": 512,
  "model": { "embed_dim": 256, "num_heads": 4, "num_layers": 3, "dropout": 0.0, "head_hidden": 64 },
  "train": {
    "batch_size": 16, "epochs": 1, "tokens_per_epoch": 61440,
    "lr": 3e-4, "min_lr": 3e-5, "weight_decay": 0.1, "warmup_steps": 5,
    "max_grad_norm": 1.0, "val_windows_pct": 0.02, "val_batches": 2,
    "curriculum": [{ "seg": "t1", "until_epoch": 1 }],
    "replay_ratio": 0.25, "log_interval": 10, "metrics_interval": 10
  },
  "heads": { "lam_fok": 0.5, "lam_conf": 0.5 },
  "rollout": { "every": 10, "batch": 12, "max_new": 8, "mix": { "t1": 0.5, "t2": 0.5, "t3": 0.0 } },
  "probe": { "n_hit": 8, "n_miss_per_set": 8 },
  "eval_rollout": { "per_set": 5, "sets": ["t1_mod7", "id_mod97", "poison_mod13", "poison_mod61"] },
  "paths": { "run_dir": "runs/smoke" }
}
